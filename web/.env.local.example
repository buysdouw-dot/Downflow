# ============================================================
# DOWNFLOW — School of Life
# Firebase / Antigravity AI environment variables
#
# Copy this file to .env.local and fill in your values.
# These are loaded at build time by Vite (VITE_ prefix required).
# .env.local is gitignored — never commit real keys.
# ============================================================

# Firebase (from Firebase Console → Project Settings → Your Apps → SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Antigravity AI Tool endpoint (your localhost:9002 server)
# When running locally: VITE_ANTIGRAVITY_AI_URL=http://localhost:9002
# When deployed: use your production URL
VITE_ANTIGRAVITY_AI_URL=
VITE_ANTIGRAVITY_AI_KEY=

# EmailJS (https://www.emailjs.com — free tier: 200 emails/month)
# Service ID: from EmailJS Dashboard → Email Services
# Public Key: from EmailJS Dashboard → Account → API Keys
# Template IDs: create templates named template_booking + template_activation
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
